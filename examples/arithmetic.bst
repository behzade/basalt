// Arithmetic operations example
import std::io;

let a = 10;
let b = 5;

io.print("a =", a);
io.print("b =", b);
io.print("a + b =", a + b);
io.print("a - b =", a - b);
io.print("a * b =", a * b);
io.print("a / b =", a / b);

// More complex expressions
let result = (a + b) * 2 - 3;
io.print("(a + b) * 2 - 3 =", result); 