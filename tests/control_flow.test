-- TEST: Return statement simple
-- INPUT
return 10;
-- EXPECT-EVAL
10
===
-- TEST: Return statement with expression
-- INPUT
return 2 * 5;
-- EXPECT-EVAL
10
===
-- TEST: Return statement early exit
-- INPUT
9; return 2 * 5; 9;
-- EXPECT-EVAL
10
===
-- TEST: Let statement simple
-- INPUT
let a = 5; a;
-- EXPECT-EVAL
5
===
-- TEST: Let statement with expression
-- INPUT
let a = 5 * 5; a;
-- EXPECT-EVAL
25
===
-- TEST: Let statement chained
-- INPUT
let a = 5; let b = a; b;
-- EXPECT-EVAL
5
===
-- TEST: Let statement complex
-- INPUT
let a = 5; let b = a; let c = a + b + 5; c;
-- EXPECT-EVAL
15
===
-- TEST: If expression simple
-- INPUT
if 10 > 1 { 10 }
-- EXPECT-EVAL
10
===
-- TEST: If expression false condition
-- INPUT
if 1 > 10 { 10 }
-- EXPECT-EVAL
null
===
-- TEST: If else expression - else branch
-- INPUT
if 1 > 10 { 10 } else { 20 }
-- EXPECT-EVAL
20
===
-- TEST: If else expression - if branch
-- INPUT
if 1 < 10 { 10 } else { 20 }
-- EXPECT-EVAL
10
===
-- TEST: If else expression - false condition
-- INPUT
if false { 10 } else { 20 }
-- EXPECT-EVAL
20
===
-- TEST: If expression - true condition
-- INPUT
if true { 10 }
-- EXPECT-EVAL
10
===
-- TEST: If expression - truthy zero
-- INPUT
if 0 { 10 } else { 20 }
-- EXPECT-EVAL
10
===
-- TEST: If expression - truthy one
-- INPUT
if 1 { 10 }
-- EXPECT-EVAL
10
===
-- TEST: If else expression - true condition
-- INPUT
if true { 10 } else { 20 }
-- EXPECT-EVAL
10
===
-- TEST: If expression - false condition returns null
-- INPUT
if false { 10 }
-- EXPECT-EVAL
null
===
-- TEST: Identifier expression parsing
-- INPUT
foobar;
-- EXPECT-AST
foobar;
===
-- TEST: Import statement parsing - simple
-- INPUT
import std::io;
-- EXPECT-AST
import std::io;
===
-- TEST: Import statement parsing - nested
-- INPUT
import std::net::http;
-- EXPECT-AST
import std::net::http;
===
-- TEST: Import statement parsing - with alias
-- INPUT
import std::io as console;
-- EXPECT-AST
import std::io as console;
===
-- TEST: Import statement parsing - filesystem alias
-- INPUT
import filesystem::utils as fs;
-- EXPECT-AST
import filesystem::utils as fs;
===
-- TEST: Import statement parsing - single module
-- INPUT
import single;
-- EXPECT-AST
import single;
===
-- TEST: For loop simple - basic loop
-- INPUT
let mut i = 0; for i < 3 { i = i + 1; } i;
-- EXPECT-EVAL
3
===
-- TEST: For loop simple - condition false initially
-- INPUT
let mut i = 5; for i < 3 { i = i + 1; } i;
-- EXPECT-EVAL
5
===
-- TEST: For loop with return - early exit
-- INPUT
let mut i = 0; for i < 10 { if i == 2 { return i; } i = i + 1; } i;
-- EXPECT-EVAL
2
===
-- TEST: For loop returns None - normal completion
-- INPUT
let mut i = 0; for i < 3 { i = i + 1; }
-- EXPECT-EVAL
null
===
-- TEST: For loop with counter - accumulation
-- INPUT
let mut sum = 0; let mut i = 0; for i < 5 { sum = sum + i; i = i + 1; } sum;
-- EXPECT-EVAL
10
===
-- TEST: For loop with boolean condition - true initially
-- INPUT
let mut flag = true; let mut count = 0; for flag { count = count + 1; if count == 3 { flag = false; } } count;
-- EXPECT-EVAL
3
===
-- TEST: For loop with boolean condition - false initially
-- INPUT
let mut flag = false; let mut count = 0; for flag { count = count + 1; } count;
-- EXPECT-EVAL
0
===
-- TEST: For loop nested - inner loop
-- INPUT
let mut sum = 0; let mut i = 0; for i < 3 { let mut j = 0; for j < 2 { sum = sum + 1; j = j + 1; } i = i + 1; } sum;
-- EXPECT-EVAL
6
===
-- TEST: For loop with function call - condition with function
-- INPUT
let isLessThan = fn(x, y) { x < y }; let mut i = 0; for isLessThan(i, 3) { i = i + 1; } i;
-- EXPECT-EVAL
3
===
-- TEST: For loop with error in condition - error propagation
-- INPUT
let mut i = 0; for i + true { i = i + 1; }
-- EXPECT-ERROR
type mismatch: INTEGER + BOOLEAN
===
-- TEST: For loop with error in body - error propagation
-- INPUT
let mut i = 0; for i < 3 { i + true; }
-- EXPECT-ERROR
type mismatch: INTEGER + BOOLEAN
===
-- TEST: For loop parsing - basic syntax
-- INPUT
for true { 42; }
-- EXPECT-AST
for true {42;}
===
-- TEST: For loop parsing - with variable condition
-- INPUT
for x < 10 { x = x + 1; }
-- EXPECT-AST
for (x < 10) {(x = (x + 1));}
===
-- TEST: For loop parsing - complex condition
-- INPUT
for (x + y) > (a * b) { doSomething(); }
-- EXPECT-AST
for ((x + y) > (a * b)) {doSomething();}
=== 
