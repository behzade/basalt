-- TEST: Type mismatch error - integer plus boolean
-- INPUT
5 + true;
-- EXPECT-ERROR
type mismatch: INTEGER + BOOLEAN
===
-- TEST: Unknown operator error - boolean minus
-- INPUT
true - false;
-- EXPECT-ERROR
unknown operator: -
===
-- TEST: Identifier not found error
-- INPUT
foobar
-- EXPECT-ERROR
identifier not found: foobar
===
-- TEST: Error in if block
-- INPUT
if (10 > 1) { true + false; }
-- EXPECT-ERROR
unknown operator: +
===
-- TEST: Error propagation
-- INPUT
5 + true; 5;
-- EXPECT-ERROR
type mismatch: INTEGER + BOOLEAN
===
-- TEST: Prefix operator error
-- INPUT
-true
-- EXPECT-ERROR
unknown operator: -SOME
===
-- TEST: Complex type mismatch
-- INPUT
5 + true + 10;
-- EXPECT-ERROR
type mismatch: INTEGER + BOOLEAN
===
-- TEST: Method access error - integer
-- INPUT
42.len()
-- EXPECT-ERROR
member access not supported on type SOME
===
-- TEST: Slice operator error - unsupported type
-- INPUT
42[1:3]
-- EXPECT-ERROR
slice operator not supported: INTEGER
=== 