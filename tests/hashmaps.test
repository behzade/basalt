-- TEST: Hash literal - empty
-- INPUT
{}
-- EXPECT-EVAL
{}
===
-- TEST: Hash literal - single string key and value
-- INPUT
{"key": "value"}
-- EXPECT-EVAL
{"key": "value"}
===
-- TEST: Hash literal - single integer key and value
-- INPUT
{1: 2}
-- EXPECT-EVAL
{1: 2}
===
-- TEST: Hash literal - single boolean key and value
-- INPUT
{true: false}
-- EXPECT-EVAL
{true: false}
===
-- TEST: Hash literal - multiple string pairs
-- INPUT
{"name": "Alice", "city": "Boston"}
-- EXPECT-EVAL
{"name": "Alice", "city": "Boston"}
===
-- TEST: Hash literal - multiple integer pairs
-- INPUT
{1: 10, 2: 20, 3: 30}
-- EXPECT-EVAL
{1: 10, 2: 20, 3: 30}
===
-- TEST: Hash literal - multiple boolean pairs
-- INPUT
{true: false, false: true}
-- EXPECT-EVAL
{true: false, false: true}
===
-- TEST: Hash literal - string keys with integer values
-- INPUT
{"age": 30, "score": 95}
-- EXPECT-EVAL
{"age": 30, "score": 95}
===
-- TEST: Hash literal - integer keys with string values
-- INPUT
{1: "one", 2: "two", 3: "three"}
-- EXPECT-EVAL
{1: "one", 2: "two", 3: "three"}
===
-- TEST: Hash literal - boolean keys with string values
-- INPUT
{true: "yes", false: "no"}
-- EXPECT-EVAL
{true: "yes", false: "no"}
===
-- TEST: Hash literal - expression values
-- INPUT
{"sum": 2 + 3, "product": 4 * 5}
-- EXPECT-EVAL
{"sum": 5, "product": 20}
===
-- TEST: Hash literal - expression keys
-- INPUT
{1 + 1: 100, 2 + 1: 200}
-- EXPECT-EVAL
{2: 100, 3: 200}
===
-- TEST: Hash index access - string key
-- INPUT
{"name": "Alice", "age": "30"}["name"]
-- EXPECT-EVAL
"Alice"
===
-- TEST: Hash index access - integer key
-- INPUT
{1: 100, 2: 200}[1]
-- EXPECT-EVAL
100
===
-- TEST: Hash index access - boolean key
-- INPUT
{true: "yes", false: "no"}[true]
-- EXPECT-EVAL
"yes"
===
-- TEST: Hash index access - variable key
-- INPUT
let key = "name"; {"name": "Alice", "city": "Boston"}[key]
-- EXPECT-EVAL
"Alice"
===
-- TEST: Hash index access - expression key
-- INPUT
{1: 100, 2: 200}[1 + 1]
-- EXPECT-EVAL
200
===
-- TEST: Hash index access - variable hash
-- INPUT
let hash = {"x": "10", "y": "20"}; hash["x"]
-- EXPECT-EVAL
"10"
===
-- TEST: Hash index access - nested access
-- INPUT
let hash = {"a": 1, "b": 2}; let key = "a"; hash[key] + hash["b"]
-- EXPECT-EVAL
3
===
-- TEST: Hash index access - missing key returns None
-- INPUT
{"a": "value"}["missing"]
-- EXPECT-EVAL
None
===
-- TEST: Hash with variable values
-- INPUT
let x = "10"; let y = "20"; {"x": x, "y": y}
-- EXPECT-EVAL
{"x": "10", "y": "20"}
===
-- TEST: Hash with function values
-- INPUT
let add = fn(a, b) { a + b }; let sub = fn(a, b) { a - b }; {"add": add, "sub": sub}["add"](5, 3)
-- EXPECT-EVAL
8
===
-- TEST: Hash with array values (same type)
-- INPUT
{"numbers": [1, 2, 3], "more": [4, 5, 6]}["numbers"][1]
-- EXPECT-EVAL
2
===
-- TEST: Hash with hash values (nested, same types)
-- INPUT
{"user": {"name": "Alice", "city": "Boston"}, "admin": {"name": "Bob", "city": "NYC"}}["user"]["name"]
-- EXPECT-EVAL
"Alice"
===
-- TEST: Hash literal AST
-- INPUT
{"key": "value"}
-- EXPECT-AST
{"key": "value"}
===
-- TEST: Hash key collision - same string
-- INPUT
{"key": "first", "key": "second"}
-- EXPECT-ERROR
duplicate key in hash literal: "key"
===
-- TEST: Hash key collision - same integer
-- INPUT
{1: 10, 1: 20}
-- EXPECT-ERROR
duplicate key in hash literal: 1
===
-- TEST: Hash key collision - same boolean
-- INPUT
{true: "first", true: "second"}
-- EXPECT-ERROR
duplicate key in hash literal: true
===
-- TEST: Hash with zero values
-- INPUT
{"zero": 0, "empty": 0}
-- EXPECT-EVAL
{"zero": 0, "empty": 0}
===
-- TEST: Hash access with zero values
-- INPUT
{"zero": 0, "empty": 0}["zero"]
-- EXPECT-EVAL
0
===
-- TEST: Hash complex key expressions
-- INPUT
let a = 1; let b = 2; {a + b: 300, a * b: 400}[3]
-- EXPECT-EVAL
300
===
-- TEST: Hash with string concatenation values
-- INPUT
{"greeting": "Hello" + " " + "World", "farewell": "Good" + "bye"}["greeting"]
-- EXPECT-EVAL
"Hello World"
===
-- TEST: Hash error - mixed key types
-- INPUT
{"string": "value", 42: "number"}
-- EXPECT-ERROR
hash key type mismatch: expected STRING, got INTEGER
===
-- TEST: Hash error - mixed value types
-- INPUT
{"first": "string", "second": 42}
-- EXPECT-ERROR
hash value type mismatch: expected STRING, got INTEGER
===
-- TEST: Hash error - boolean and string keys
-- INPUT
{"false": "no", true: "yes"}
-- EXPECT-ERROR
hash key type mismatch: expected STRING, got BOOLEAN
===
-- TEST: Hash error - integer and boolean values
-- INPUT
{"a": 1, "b": true}
-- EXPECT-ERROR
hash value type mismatch: expected INTEGER, got BOOLEAN
===
-- TEST: Hash error - array as key
-- INPUT
{[1, 2]: "array"}
-- EXPECT-ERROR
unusable as hash key: ARRAY
===
-- TEST: Hash error - hash as key
-- INPUT
{{"nested": "true"}: "value"}
-- EXPECT-ERROR
unusable as hash key: HASH
===
-- TEST: Hash error - function as key
-- INPUT
{fn() { 42 }: "function"}
-- EXPECT-ERROR
unusable as hash key: FUNCTION
===
-- TEST: Hash access error - wrong key type
-- INPUT
{"string": "value"}[42]
-- EXPECT-ERROR
hash key type mismatch: expected STRING, got INTEGER
===
-- TEST: Hash access error - array as key
-- INPUT
let arr = [1, 2]; {"valid": "value"}[arr]
-- EXPECT-ERROR
unusable as hash key: ARRAY
===
-- TEST: Hash access error - hash as key
-- INPUT
{"valid": "value"}[{"nested": "true"}]
-- EXPECT-ERROR
unusable as hash key: HASH
===
-- TEST: Hash access error - function as key
-- INPUT
let func = fn() { 42 }; {"valid": "value"}[func]
-- EXPECT-ERROR
unusable as hash key: FUNCTION
=== 