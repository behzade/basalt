-- TEST: Prefix expression parsing - bang
-- INPUT
!5;
-- EXPECT-AST
(!5);
===
-- TEST: Operator precedence - bang and negation
-- INPUT
!-a
-- EXPECT-AST
(!(-a))
===
-- TEST: Operator precedence - comparison and equality
-- INPUT
5 > 4 == 3 < 4
-- EXPECT-AST
((5 > 4) == (3 < 4))
===
-- TEST: Operator precedence - comparison and inequality
-- INPUT
5 < 4 != 3 > 4
-- EXPECT-AST
((5 < 4) != (3 > 4))
===
-- TEST: Operator precedence - arithmetic and equality
-- INPUT
3 + 4 * 5 == 3 * 1 + 4 * 5
-- EXPECT-AST
((3 + (4 * 5)) == ((3 * 1) + (4 * 5)))
===
-- TEST: Operator precedence - boolean and equality
-- INPUT
3 > 5 == false
-- EXPECT-AST
((3 > 5) == false)
===
-- TEST: Operator precedence - boolean and equality true
-- INPUT
3 < 5 == true
-- EXPECT-AST
((3 < 5) == true)
===
-- TEST: Operator precedence - parentheses bang
-- INPUT
!(true == true)
-- EXPECT-AST
(!(true == true))
===
-- TEST: Greater than parsing
-- INPUT
5 > 5;
-- EXPECT-AST
(5 > 5);
===
-- TEST: Less than parsing
-- INPUT
5 < 5;
-- EXPECT-AST
(5 < 5);
===
-- TEST: Equality parsing
-- INPUT
5 == 5;
-- EXPECT-AST
(5 == 5);
===
-- TEST: Inequality parsing
-- INPUT
5 != 5;
-- EXPECT-AST
(5 != 5);
