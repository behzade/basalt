-- TEST: Integer literal
-- INPUT
5
-- EXPECT-EVAL
5
===
-- TEST: Negative integer
-- INPUT
-5
-- EXPECT-EVAL
-5
===
-- TEST: Integer addition
-- INPUT
5 + 5 + 5 + 5 - 10
-- EXPECT-EVAL
10
===
-- TEST: Integer multiplication
-- INPUT
2 * 2 * 2 * 2 * 2
-- EXPECT-EVAL
32
===
-- TEST: Mixed arithmetic operations
-- INPUT
-50 + 100 + -50
-- EXPECT-EVAL
0
===
-- TEST: Operator precedence - multiplication first
-- INPUT
5 * 2 + 10
-- EXPECT-EVAL
20
===
-- TEST: Operator precedence - addition second
-- INPUT
5 + 2 * 10
-- EXPECT-EVAL
25
===
-- TEST: Operator precedence - with negation
-- INPUT
20 + 2 * -10
-- EXPECT-EVAL
0
===
-- TEST: Division and multiplication
-- INPUT
50 / 2 * 2 + 10
-- EXPECT-EVAL
60
===
-- TEST: Parentheses override precedence
-- INPUT
2 * (5 + 10)
-- EXPECT-EVAL
30
===
-- TEST: Exponentiation precedence
-- INPUT
3 * 3 * 3 + 10
-- EXPECT-EVAL
37
===
-- TEST: Parentheses with exponentiation
-- INPUT
3 * (3 * 3) + 10
-- EXPECT-EVAL
37
===
-- TEST: Complex arithmetic expression
-- INPUT
(5 + 10 * 2 + 15 / 3) * 2 + -10
-- EXPECT-EVAL
50
===
-- TEST: Integer literal parsing
-- INPUT
5;
-- EXPECT-AST
5
===
-- TEST: Negation parsing
-- INPUT
-15;
-- EXPECT-AST
(-15)
===
-- TEST: Addition parsing
-- INPUT
5 + 5;
-- EXPECT-AST
(5 + 5)
===
-- TEST: Subtraction parsing
-- INPUT
5 - 5;
-- EXPECT-AST
(5 - 5)
===
-- TEST: Multiplication parsing
-- INPUT
5 * 5;
-- EXPECT-AST
(5 * 5)
===
-- TEST: Division parsing
-- INPUT
5 / 5;
-- EXPECT-AST
(5 / 5)
===
-- TEST: Operator precedence - negation and multiplication
-- INPUT
-a * b
-- EXPECT-AST
((-a) * b)
===
-- TEST: Operator precedence - left associative addition
-- INPUT
a + b + c
-- EXPECT-AST
((a + b) + c)
===
-- TEST: Operator precedence - left associative subtraction
-- INPUT
a + b - c
-- EXPECT-AST
((a + b) - c)
===
-- TEST: Operator precedence - left associative multiplication
-- INPUT
a * b * c
-- EXPECT-AST
((a * b) * c)
===
-- TEST: Operator precedence - left associative division
-- INPUT
a * b / c
-- EXPECT-AST
((a * b) / c)
===
-- TEST: Operator precedence - multiplication over addition
-- INPUT
a + b / c
-- EXPECT-AST
(a + (b / c))
===
-- TEST: Operator precedence - complex expression
-- INPUT
a + b * c + d / e - f
-- EXPECT-AST
(((a + (b * c)) + (d / e)) - f)
===
-- TEST: Operator precedence - multiple statements
-- INPUT
3 + 4; -5 * 5
-- EXPECT-AST
(3 + 4)((-5) * 5)
===
-- TEST: Operator precedence - parentheses override
-- INPUT
1 + (2 + 3) + 4
-- EXPECT-AST
((1 + (2 + 3)) + 4)
===
-- TEST: Operator precedence - parentheses multiplication
-- INPUT
(5 + 5) * 2
-- EXPECT-AST
((5 + 5) * 2)
===
-- TEST: Operator precedence - parentheses division
-- INPUT
2 / (5 + 5)
-- EXPECT-AST
(2 / (5 + 5))
===
-- TEST: Operator precedence - parentheses negation
-- INPUT
-(5 + 5)
-- EXPECT-AST
(-(5 + 5))
===
-- TEST: Float literal
-- INPUT
3.14
-- EXPECT-EVAL
3.140000
===
-- TEST: Float literal with zero
-- INPUT
0.5
-- EXPECT-EVAL
0.500000
===
-- TEST: Negative float
-- INPUT
-3.14
-- EXPECT-EVAL
-3.140000
===
-- TEST: Float addition
-- INPUT
3.14 + 2.86
-- EXPECT-EVAL
6.000000
===
-- TEST: Float subtraction
-- INPUT
5.5 - 2.5
-- EXPECT-EVAL
3.000000
===
-- TEST: Float multiplication
-- INPUT
2.5 * 4.0
-- EXPECT-EVAL
10.000000
===
-- TEST: Float division
-- INPUT
7.5 / 2.5
-- EXPECT-EVAL
3.000000
===
-- TEST: Mixed-mode arithmetic - integer plus float
-- INPUT
5 + 3.14
-- EXPECT-EVAL
8.140000
===
-- TEST: Mixed-mode arithmetic - float plus integer
-- INPUT
3.14 + 5
-- EXPECT-EVAL
8.140000
===
-- TEST: Mixed-mode arithmetic - integer minus float
-- INPUT
10 - 3.14
-- EXPECT-EVAL
6.860000
===
-- TEST: Mixed-mode arithmetic - float minus integer
-- INPUT
3.14 - 1
-- EXPECT-EVAL
2.140000
===
-- TEST: Mixed-mode arithmetic - integer times float
-- INPUT
3 * 2.5
-- EXPECT-EVAL
7.500000
===
-- TEST: Mixed-mode arithmetic - float times integer
-- INPUT
2.5 * 3
-- EXPECT-EVAL
7.500000
===
-- TEST: Mixed-mode arithmetic - integer divided by float
-- INPUT
10 / 2.5
-- EXPECT-EVAL
4.000000
===
-- TEST: Mixed-mode arithmetic - float divided by integer
-- INPUT
7.5 / 3
-- EXPECT-EVAL
2.500000
===
-- TEST: Float comparison - less than
-- INPUT
3.14 < 5.0
-- EXPECT-EVAL
true
===
-- TEST: Float comparison - greater than
-- INPUT
5.0 > 3.14
-- EXPECT-EVAL
true
===
-- TEST: Float comparison - equal
-- INPUT
3.14 == 3.14
-- EXPECT-EVAL
true
===
-- TEST: Float comparison - not equal
-- INPUT
3.14 != 2.71
-- EXPECT-EVAL
true
===
-- TEST: Mixed-mode comparison - integer less than float
-- INPUT
3 < 3.14
-- EXPECT-EVAL
true
===
-- TEST: Mixed-mode comparison - float greater than integer
-- INPUT
3.14 > 3
-- EXPECT-EVAL
true
===
-- TEST: Complex float arithmetic
-- INPUT
(3.14 + 2.86) * 2.0 - 1.5
-- EXPECT-EVAL
10.500000
===
