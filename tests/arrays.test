-- TEST: Array literal
-- INPUT
[1, 2 * 2, 3 + 3]
-- EXPECT-EVAL
[1, 4, 6]
===
-- TEST: Empty array
-- INPUT
[]
-- EXPECT-EVAL
[]
===
-- TEST: Array index access - first element
-- INPUT
[1, 2, 3][0]
-- EXPECT-EVAL
1
===
-- TEST: Array index access - second element
-- INPUT
[1, 2, 3][1]
-- EXPECT-EVAL
2
===
-- TEST: Array index access - third element
-- INPUT
[1, 2, 3][2]
-- EXPECT-EVAL
3
===
-- TEST: Array index access - variable index
-- INPUT
let i = 0; [1][i];
-- EXPECT-EVAL
1
===
-- TEST: Array index access - expression index
-- INPUT
[1, 2, 3][1 + 1];
-- EXPECT-EVAL
3
===
-- TEST: Array index access - variable array
-- INPUT
let myArray = [1, 2, 3]; myArray[2];
-- EXPECT-EVAL
3
===
-- TEST: Array index access - sum
-- INPUT
let myArray = [1, 2, 3]; myArray[0] + myArray[1] + myArray[2];
-- EXPECT-EVAL
6
===
-- TEST: Array index access - nested
-- INPUT
let myArray = [1, 2, 3]; let i = myArray[0]; myArray[i]
-- EXPECT-EVAL
2
===
-- TEST: Array method - length
-- INPUT
[1, 2, 3, 4].len()
-- EXPECT-EVAL
4
===
-- TEST: Array method - empty length
-- INPUT
[].len()
-- EXPECT-EVAL
0
===
-- TEST: Array method - variable length
-- INPUT
let arr = [1, 2, 3]; arr.len()
-- EXPECT-EVAL
3
===
-- TEST: Array slicing - middle
-- INPUT
[1, 2, 3, 4][1:3]
-- EXPECT-EVAL
[2, 3]
===
-- TEST: Array slicing - from start
-- INPUT
[1, 2, 3, 4][:2]
-- EXPECT-EVAL
[1, 2]
===
-- TEST: Array slicing - to end
-- INPUT
[1, 2, 3, 4][2:]
-- EXPECT-EVAL
[3, 4]
===
-- TEST: Array slicing - full
-- INPUT
[1, 2, 3, 4][:]
-- EXPECT-EVAL
[1, 2, 3, 4]
===
-- TEST: Array slicing - empty
-- INPUT
[1, 2, 3, 4][1:1]
-- EXPECT-EVAL
[]
===
-- TEST: Array slicing - variable
-- INPUT
let arr = [1, 2, 3, 4]; arr[1:3]
-- EXPECT-EVAL
[2, 3]
===
-- TEST: Slice method - length
-- INPUT
[1, 2, 3, 4][1:3].len()
-- EXPECT-EVAL
2
===
-- TEST: Slice method - length from start
-- INPUT
[1, 2, 3, 4][:2].len()
-- EXPECT-EVAL
2
===
-- TEST: Slice method - length to end
-- INPUT
[1, 2, 3, 4][2:].len()
-- EXPECT-EVAL
2
===
-- TEST: Slice method - empty length
-- INPUT
[1, 2, 3, 4][1:1].len()
-- EXPECT-EVAL
0
===
-- TEST: Array index out of bounds
-- INPUT
[1, 2, 3][3]
-- EXPECT-ERROR
index out of bounds
===
-- TEST: Array index negative
-- INPUT
[1, 2, 3][-1]
-- EXPECT-ERROR
index out of bounds
===
-- TEST: Array type enforcement - mixed types
-- INPUT
[1, "hello"]
-- EXPECT-ERROR
array elements must be of the same type
===
-- TEST: Array type enforcement - boolean and integer
-- INPUT
[true, 42]
-- EXPECT-ERROR
array elements must be of the same type
===
-- TEST: Array type enforcement - multiple mixed
-- INPUT
[1, 2, "three"]
-- EXPECT-ERROR
array elements must be of the same type
===
-- TEST: Array method error - undefined method
-- INPUT
[1, 2, 3].foo()
-- EXPECT-ERROR
undefined method 'foo' on array
===
-- TEST: Array slicing error - start out of bounds
-- INPUT
[1, 2, 3][5:10]
-- EXPECT-ERROR
start index out of bounds
===
-- TEST: Array slicing error - negative start
-- INPUT
[1, 2, 3][-1:2]
-- EXPECT-ERROR
start index out of bounds
===
-- TEST: Array slicing error - end out of bounds
-- INPUT
[1, 2, 3][1:10]
-- EXPECT-ERROR
end index out of bounds
===
-- TEST: Array slicing error - negative end
-- INPUT
[1, 2, 3][1:-1]
-- EXPECT-ERROR
end index out of bounds
===
-- TEST: Slice index error - start not integer
-- INPUT
[1, 2, 3]["a":2]
-- EXPECT-ERROR
start index must be an integer
===
-- TEST: Slice index error - end not integer
-- INPUT
[1, 2, 3][1:"b"]
-- EXPECT-ERROR
end index must be an integer
===
-- TEST: Index expression parsing
-- INPUT
myArray[1 + 1]
-- EXPECT-AST
(myArray[(1 + 1)])
===
-- TEST: Slicing expression parsing - middle slice
-- INPUT
array[1:3]
-- EXPECT-AST
(array[1:3])
===
-- TEST: Slicing expression parsing - from start
-- INPUT
array[:3]
-- EXPECT-AST
(array[:3])
===
-- TEST: Slicing expression parsing - to end
-- INPUT
array[1:]
-- EXPECT-AST
(array[1:])
===
-- TEST: Slicing expression parsing - full slice
-- INPUT
array[:]
-- EXPECT-AST
(array[:])
===
-- TEST: Slicing expression parsing - array literal
-- INPUT
[1, 2, 3][0:2]
-- EXPECT-AST
([1, 2, 3][0:2])
=== 